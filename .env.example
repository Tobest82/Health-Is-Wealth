# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# SUPABASE DATABASE & CLOUD PERSISTENCE
# ==============================================================================
# Enter your Supabase credentials in Google AI Studio via the Settings -> Environment Variables menu,
# or set them in your local .env file.
#
# VITE_SUPABASE_URL: Your Supabase project URL (e.g., https://xyzcompanyproject.supabase.co)
VITE_SUPABASE_URL=

# VITE_SUPABASE_ANON_KEY: Your Supabase project anon/public API key
# (Found in Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon public)
VITE_SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY: (Optional) Secret Service Role key for backend administrative operations
SUPABASE_SERVICE_ROLE_KEY=
